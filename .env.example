# E-mail de notificação de lead (opcional em v1 — sem isso, o lead só é logado no servidor)
RESEND_API_KEY=
LEAD_FROM_EMAIL=onboarding@resend.dev
LEAD_TO_EMAIL=

# Sincronia real do calendário de disponibilidade (opcional — sem isso, o
# calendário usa dados de demonstração). Pegar no painel do anfitrião:
# Airbnb: Calendário > Disponibilidade > Sincronizar calendários > Exportar calendário
# Booking.com: Extranet > Tarifas e disponibilidade > Sincronizar calendários
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=

# v2 — pagamento (ver ESTRUTURA_FUNCIONALIDADES_CHALE.md)
# MERCADOPAGO_TOKEN=
